# ==============================================================================
# NEURA AI — .gitignore
# ==============================================================================

# Python Bytecode & Distribution
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
.venv/
env/
ENV/
env.bak/
venv.bak/

# Environment Variables & Private Secrets
.env
.env.local
.env.*.local
*.pem
*.key

# Persistent Storage, Sessions, & Runtime Logs
storage/framework/sessions/*
!storage/framework/sessions/.gitkeep
storage/logs/*.log
!storage/logs/.gitkeep
storage/app/*
!storage/app/.gitkeep
!storage/app/consultations_records.json
!storage/app/notifications.json

# Large AI Models & Binaries (GGUF, Keras, H5)
storage/modelsLLM/*.gguf
storage/modelsLLM/*.bin
!storage/modelsLLM/.gitkeep
modelsLLM/
storage/checkpoints/*.keras
storage/checkpoints/*.h5
storage/checkpoints/NeuralNetwork/
!storage/checkpoints/.gitkeep
!storage/checkpoints/xgboost_alzheimers.json

# Reports & Metrics (keep .gitkeep and reports)
!storage/reports/.gitkeep

# Temporary Scripts & Test Caches
scratch/
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/

# Jupyter Notebooks & Checkpoints
.ipynb_checkpoints/
*.ipynb

# Legacy Session Folders & Backups
.flask_sessions/
*.bak

# Operating System Metadata
.DS_Store
Thumbs.db
desktop.ini

# IDE & Editor Settings
.idea/
*.swp
*.swo
*~
.vscode/
