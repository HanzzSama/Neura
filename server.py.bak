# -----------------------------------------------------------------------
# API — About App (single source of truth from about_app.json)
# -----------------------------------------------------------------------
_about_cache = None
_about_cache_mtime = 0

@app.route("/api/about", methods=["GET"])
def api_about():
    """
    Returns the full app metadata from about_app.json.
    Auto-reloads whenever about_app.json is modified on disk.
    """
    global _about_cache, _about_cache_mtime

    about_path = Path("about_app.json")
    if not about_path.exists():
        return jsonify({"error": "about_app.json not found"}), 404

    try:
        current_mtime = about_path.stat().st_mtime
        if _about_cache is not None and current_mtime == _about_cache_mtime:
            return jsonify(_about_cache)

        with open(about_path, "r", encoding="utf-8") as f:
            data = json.load(f)
        # Strip comment fields before sending to client
        _about_cache = {k: v for k, v in data.items() if not k.startswith("_comment")}
        _about_cache_mtime = current_mtime
        return jsonify(_about_cache)
    except Exception as e:
        logger.error(f"[about] Failed to read about_app.json: {e}")
        return jsonify({"error": "Failed to read about_app.json"}), 500


@app.route("/api/send-verification-email", methods=["POST"])
def api_send_verification_email():
    """
    Generate Firebase email verification link dan kirim custom HTML email
    dengan nama pengirim 'Neura AI' via Gmail SMTP.

    Body JSON: { "email": str, "displayName": str, "continueUrl": str (optional) }
    """
    from core.email_sender import send_verification_email, is_smtp_configured

    body         = request.get_json(silent=True) or {}
    email        = (body.get("email") or "").strip()
    display_name = (body.get("displayName") or email.split("@")[0]).strip()
    continue_url = (body.get("continueUrl") or f"http://localhost:5000/verify-email").strip()

    if not email or "@" not in email:
        return jsonify({"success": False, "error": "Email tidak valid."}), 400

    if not is_smtp_configured():
        return jsonify({
            "success": False,
            "error": "SMTP belum dikonfigurasi. Isi SMTP_EMAIL dan SMTP_PASSWORD di .env",
            "smtp_required": True
        }), 503

    # Generate Firebase verification link via Admin SDK
    verify_link = None
    fb_auth = get_firebase_admin_auth()
    if fb_auth:
        try:
            action_settings = fb_auth.ActionCodeSettings(
                url=continue_url,
                handle_code_in_app=False
            )
            verify_link = fb_auth.generate_email_verification_link(email, action_code_settings=action_settings)
        except Exception as e:
            logger.warning(f"[Firebase Admin] Gagal generate link: {e}")

    # Fallback jika Admin SDK tidak tersedia
    if not verify_link:
        return jsonify({
            "success": False,
            "error": "Firebase Admin SDK belum dikonfigurasi. Tambahkan kredensial service account di .env",
            "admin_required": True
        }), 503

    # Kirim custom HTML email
    result = send_verification_email(email, display_name, verify_link)
    status_code = 200 if result["success"] else 500
    return jsonify(result), status_code


# -----------------------------------------------------------------------
# API — Admin Custom Email & 2FA OTP Authentication
# -----------------------------------------------------------------------
_admin_otp_store = {}  # { email: { "otp": str, "expires_at": float, "attempts": int } }
_admin_sessions = {}   # { token: { "email": str, "name": str, "role": str, "created_at": float } }

@app.route("/api/admin/emails", methods=["GET"])
def api_admin_emails():
    """Daftar email custom admin terdaftar untuk deteksi instan (0ms) di browser."""
    from core.admin_config import get_all_admin_custom_emails
    return jsonify({
        "admin_emails": get_all_admin_custom_emails(),
        "admin_domains": ["neura.dr.id"]
    })


@app.route("/api/admin/check-email", methods=["POST"])
def api_admin_check_email():
    """
    Periksa apakah email yang dimasukkan adalah email custom admin (contoh: hanzz@neura.dr.id).
    """
    from core.admin_config import get_admin_by_custom_email, mask_email

    body = request.get_json(silent=True) or {}
    email = (body.get("email") or "").strip().lower()

    admin = get_admin_by_custom_email(email)
    if not admin:
        return jsonify({"is_admin": False})

    real_emails = admin.get("real_emails", [])
    masked = [mask_email(e) for e in real_emails]

    return jsonify({
        "is_admin": True,
        "custom_email": email,
        "name": admin.get("name", "Administrator"),
        "role": admin.get("role", "Admin"),
        "masked_emails": masked,
        "real_emails_count": len(real_emails)
    })


@app.route("/api/admin/send-otp", methods=["POST"])
def api_admin_send_otp():
    """
    Generate kode OTP 6-digit dan kirim ke seluruh alamat email asli yang ada dalam array.
    """
    import time
    import random
    from core.admin_config import get_admin_by_custom_email, mask_email
    from core.email_sender import send_admin_otp_email, is_smtp_configured

    body = request.get_json(silent=True) or {}
    email = (body.get("email") or "").strip().lower()

    admin = get_admin_by_custom_email(email)
    if not admin:
        return jsonify({"success": False, "error": "Email bukan merupakan akun admin terdaftar."}), 404

    real_emails = admin.get("real_emails", [])
    if not real_emails:
        return jsonify({"success": False, "error": "Tidak ada email asli terhubung untuk admin ini."}), 400

    # Generate 6-digit OTP
    otp_code = f"{random.randint(100000, 999999):06d}"
    expires_at = time.time() + 300  # 5 menit

    _admin_otp_store[email] = {
        "otp": otp_code,
        "expires_at": expires_at,
        "attempts": 0
    }

    # Kirim email ke semua email dalam array real_emails
    send_result = send_admin_otp_email(
        to_emails=real_emails,
        admin_name=admin.get("name", "Administrator"),
        otp_code=otp_code,
        custom_email=email
    )

    logger.info(f"[Admin OTP] Generated OTP {otp_code} for admin {email} (dest: {real_emails})")

    masked_list = [mask_email(e) for e in real_emails]
    smtp_ok = bool(send_result.get("success", False))

    response_data = {
        "success": True,
        "message": f"Kode OTP telah dikirimkan ke email terhubung.",
        "custom_email": email,
        "masked_emails": masked_list,
        "smtp_sent": smtp_ok,
        "expires_in_seconds": 300
    }

    # Jika SMTP belum disiapkan di .env atau gagal di local dev, sertakan dev_otp agar pengujian tidak terblokir
    if not smtp_ok or not is_smtp_configured():
        response_data["dev_otp"] = otp_code
        response_data["dev_note"] = "SMTP belum dikonfigurasi di .env; kode OTP disimulasikan untuk kemudahan pengujian lokal."

    return jsonify(response_data)


@app.route("/api/admin/verify-otp", methods=["POST"])
def api_admin_verify_otp():
    """
    Verifikasi kode OTP yang dimasukkan oleh admin di card Verify Admin.
    """
    import time
    import uuid
    from core.admin_config import get_admin_by_custom_email

    body = request.get_json(silent=True) or {}
    email = (body.get("email") or "").strip().lower()
    input_otp = str(body.get("otp") or "").strip()

    admin = get_admin_by_custom_email(email)
    if not admin:
        return jsonify({"success": False, "error": "Email bukan akun admin terdaftar."}), 404

    record = _admin_otp_store.get(email)
    if not record:
        return jsonify({"success": False, "error": "Kode OTP belum diminta atau sudah kedaluwarsa. Silakan minta kode baru."}), 400

    now = time.time()
    if now > record["expires_at"]:
        _admin_otp_store.pop(email, None)
        return jsonify({"success": False, "error": "Kode OTP telah kedaluwarsa (lebih dari 5 menit). Silakan minta kode baru."}), 400

    if record["attempts"] >= 5:
        _admin_otp_store.pop(email, None)
        return jsonify({"success": False, "error": "Batas percobaan OTP terlampaui. Silakan minta kode baru."}), 429

    if input_otp != record["otp"]:
        record["attempts"] += 1
        sisa = max(0, 5 - record["attempts"])
        return jsonify({
            "success": False,
            "error": f"Kode OTP salah. Sisa kesempatan: {sisa} kali."
        }), 400

    # Berhasil! Hapus OTP agar tidak bisa digunakan ulang (sekali pakai)
    _admin_otp_store.pop(email, None)

    # Buat session token aman untuk admin
    admin_token = str(uuid.uuid4())
    _admin_sessions[admin_token] = {
        "email": email,
        "name": admin.get("name", "Administrator"),
        "role": "Admin",
        "created_at": time.time()
    }

    return jsonify({
        "success": True,
        "message": "Autentikasi Dua Faktor Admin berhasil!",
        "token": admin_token,
        "admin": {
            "custom_email": email,
            "name": admin.get("name", "Administrator"),
            "role": "Admin",
            "real_emails": admin.get("real_emails", [])
        }
    })


@app.route("/api/admin/verify-session", methods=["POST", "GET"])
def api_admin_verify_session():
    """Validasi token sesi admin yang disimpan di browser."""
    import time

    token = ""
    if request.method == "POST":
        body = request.get_json(silent=True) or {}
        token = str(body.get("token") or "").strip()
    if not token:
        token = (
            request.args.get("token")
            or request.headers.get("X-Admin-Token")
            or ""
        ).strip()

    if token and token in _admin_sessions:
        session = _admin_sessions[token]
        # Berlaku 24 jam (86400 detik)
        if (time.time() - session["created_at"]) < 86400:
            return jsonify({
                "valid": True,
                "admin": {
                    "email": session["email"],
                    "name": session["name"],
                    "role": session["role"]
                }
            })
        else:
            _admin_sessions.pop(token, None)

    return jsonify({"valid": False, "error": "Sesi admin tidak valid atau telah kedaluwarsa."}), 401


@app.route("/api/admin/logout", methods=["POST"])
def api_admin_logout():
    """Hapus sesi admin di server."""
    body = request.get_json(silent=True) or {}
    token = str(body.get("token") or "").strip()
    if token and token in _admin_sessions:
        _admin_sessions.pop(token, None)
    return jsonify({"success": True})


# -----------------------------------------------------------------------
# API — Admin: Manajemen Data Tenaga Kesehatan (Nakes) Profesional
# -----------------------------------------------------------------------
NAKES_DB_FILE = Path(__file__).resolve().parent / "datasets" / "nakes_directory.json"

def _load_nakes_db():
    if not NAKES_DB_FILE.exists():
        return []
    try:
        with open(NAKES_DB_FILE, "r", encoding="utf-8") as f:
            return json.load(f)
    except Exception as e:
        logger.error(f"Gagal membaca nakes_directory.json: {e}")
        return []

def _save_nakes_db(data):
    try:
        NAKES_DB_FILE.parent.mkdir(parents=True, exist_ok=True)
        with open(NAKES_DB_FILE, "w", encoding="utf-8") as f:
            json.dump(data, f, indent=2, ensure_ascii=False)
        return True
    except Exception as e:
        logger.error(f"Gagal menyimpan nakes_directory.json: {e}")
        return False

@app.route("/api/admin/nakes", methods=["GET"])
def api_get_nakes():
    """Mengambil seluruh data tenaga kesehatan profesional terdaftar."""
    items = _load_nakes_db()
    return jsonify({"success": True, "data": items, "total": len(items)})

@app.route("/api/admin/nakes", methods=["POST"])
def api_create_nakes():
    """Menambah data tenaga kesehatan profesional baru dengan validasi dan auto-generate @neura.ns.id."""
    import time
    import random
    body = request.get_json(silent=True) or {}
    
    name = (body.get("name") or "").strip()
    profession = (body.get("profession") or "Dokter Spesialis Neurologi (Sp.N)").strip()
    str_number = (body.get("str_number") or "").strip()
    sip_number = (body.get("sip_number") or "").strip()
    institution = (body.get("institution") or "").strip()
    phone = (body.get("phone") or "").strip()
    real_email = (body.get("real_email") or "").strip().lower()
    nakes_email = (body.get("nakes_email") or "").strip().lower()
    status = (body.get("status") or "Terverifikasi KKI").strip()
    
    if not name:
        return jsonify({"success": False, "error": "Nama lengkap nakes beserta gelar wajib diisi."}), 400
    if not real_email or "@" not in real_email:
        return jsonify({"success": False, "error": "Email asli (pribadi) yang valid wajib diisi."}), 400
        
    # Auto-generate domain @neura.ns.id jika tidak valid atau belum diisi
    if not nakes_email or not nakes_email.endswith("@neura.ns.id"):
        username = real_email.split("@")[0].strip()
        clean_user = re.sub(r"[^a-zA-Z0-9._-]", "", username) or "nakes"
        nakes_email = f"{clean_user}@neura.ns.id"

    items = _load_nakes_db()
    
    # Periksa apakah email nakes sudah terdaftar
    for item in items:
        if item.get("nakes_email", "").lower() == nakes_email:
            return jsonify({"success": False, "error": f"Email nakes {nakes_email} sudah terdaftar."}), 400

    new_id = f"NKS-{time.strftime('%Y')}-{len(items) + 1:03d}"
    # Auto-generate password: nks{year}{seq} misal NKS-2026-004 → nks2026004
    _id_parts = new_id.split("-")  # ['NKS', '2026', '004']
    _default_pwd = f"nks{''.join(_id_parts[1:])}"  # nks2026004
    password = (body.get("password") or "").strip() or _default_pwd
    record = {
        "id": new_id,
        "name": name,
        "profession": profession,
        "str_number": str_number or f"{random.randint(10,99)}.{random.randint(1,9)}.{random.randint(1,9)}.{random.randint(100,999)}.{random.randint(1,9)}.{random.randint(20,26)}.{random.randint(100000,999999)}",
        "sip_number": sip_number or f"503/SIP/{random.randint(100,999)}/Dinkes/{time.strftime('%Y')}",
        "institution": institution or "Fasilitas Kesehatan Mitra Neura",
        "phone": phone,
        "real_email": real_email,
        "nakes_email": nakes_email,
        "password": password,
        "status": status,
        "created_at": time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime())
    }
    
    items.insert(0, record)
    _save_nakes_db(items)
    return jsonify({
        "success": True, 
        "message": "Data tenaga kesehatan profesional berhasil disimpan.", 
        "data": record
    }), 201

@app.route("/api/admin/nakes/<nakes_id>", methods=["DELETE"])
def api_delete_nakes(nakes_id):
    """Menghapus data tenaga kesehatan berdasarkan ID."""
    items = _load_nakes_db()
    original_len = len(items)
    items = [it for it in items if it.get("id") != nakes_id]
    if len(items) == original_len:
        return jsonify({"success": False, "error": "Data nakes tidak ditemukan."}), 404
    _save_nakes_db(items)
    return jsonify({"success": True, "message": f"Data nakes {nakes_id} berhasil dihapus."})


@app.route("/api/nakes/login", methods=["POST"])
def api_nakes_login():
    """Autentikasi login tenaga kesehatan profesional menggunakan email nakes (@neura.ns.id) / email asli dan password (default: nks{tahun}{urutan}, contoh: nks2026001)."""
    body = request.get_json(silent=True) or {}
    email = (body.get("email") or "").strip().lower()
    password = str(body.get("password") or "").strip()

    if not email:
        return jsonify({"success": False, "error": "Email nakes wajib diisi."}), 400
    if not password:
        return jsonify({"success": False, "error": "Kata sandi wajib diisi."}), 400

    items = _load_nakes_db()
    matched = None
    for item in items:
        if item.get("nakes_email", "").lower() == email or item.get("real_email", "").lower() == email:
            matched = item
            break

    if not matched:
        return jsonify({"success": False, "error": "Akun tenaga kesehatan tidak terdaftar dalam direktori Neura."}), 404

    # Fallback: jika kolom password belum ada, derive dari ID (backward compat)
    stored_pwd = matched.get("password") or ""
    if not stored_pwd:
        _parts = (matched.get("id") or "NKS-2024-001").split("-")
        stored_pwd = f"nks{''.join(_parts[1:])}"
    nakes_pwd = str(stored_pwd).strip()
    if password != nakes_pwd:
        return jsonify({"success": False, "error": "Kata sandi nakes salah. Format default: nks{tahun}{urutan}, contoh nks2026001."}), 401

    return jsonify({
        "success": True,
        "message": f"Selamat datang, {matched.get('name')}!",
        "user": {
            "uid": matched.get("id"),
            "name": matched.get("name"),
            "displayName": matched.get("name"),
            "email": matched.get("nakes_email"),
            "real_email": matched.get("real_email"),
            "role": "Nakes",
            "profession": matched.get("profession"),
            "str_number": matched.get("str_number"),
            "sip_number": matched.get("sip_number"),
            "institution": matched.get("institution"),
            "phone": matched.get("phone"),
            "status": matched.get("status")
        }
    })




