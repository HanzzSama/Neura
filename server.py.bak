logger = get_logger(__name__)

# Pre-warm ML libraries in background so the first training run starts immediately
def _warmup_ml_libs():
    try:
        import xgboost  # noqa
        import pandas  # noqa
        import sklearn  # noqa
    except Exception:
        pass
threading.Thread(target=_warmup_ml_libs, daemon=True).start()

# -----------------------------------------------------------------------
# Firebase Admin SDK — untuk generate email verification link
# -----------------------------------------------------------------------
_firebase_admin_initialized = False

def get_firebase_admin_auth():
    """Lazy-init Firebase Admin SDK menggunakan kredensial dari .env."""
    global _firebase_admin_initialized
    try:
        import firebase_admin
        from firebase_admin import auth as fb_auth, credentials

        if not _firebase_admin_initialized:
            # Coba dari file service account JSON (lebih aman)
            sa_path = os.getenv("FIREBASE_SERVICE_ACCOUNT_PATH", "").strip()
            if sa_path and os.path.exists(sa_path):
                cred = credentials.Certificate(sa_path)
            else:
                # Fallback: buat credentials dari .env variables
                cred = credentials.Certificate({
                    "type": "service_account",
                    "project_id": os.getenv("FIREBASE_PROJECT_ID", ""),
                    "private_key_id": os.getenv("FIREBASE_PRIVATE_KEY_ID", ""),
                    "private_key": os.getenv("FIREBASE_PRIVATE_KEY", "").replace("\\n", "\n"),
                    "client_email": os.getenv("FIREBASE_CLIENT_EMAIL", ""),
                    "client_id": os.getenv("FIREBASE_CLIENT_ID", ""),
                    "auth_uri": "https://accounts.google.com/o/oauth2/auth",
                    "token_uri": "https://oauth2.googleapis.com/token",
                })

            if not firebase_admin._apps:
                firebase_admin.initialize_app(cred)
            _firebase_admin_initialized = True

        return fb_auth
    except Exception as e:
        logger.warning(f"[Firebase Admin] Tidak dapat diinisialisasi: {e}")
        return None

app = Flask(__name__, static_folder="public", static_url_path="")
CORS(app)

# -----------------------------------------------------------------------
# Globals — model loaded lazily on first use
# -----------------------------------------------------------------------
_model = None
_model_lock = threading.Lock()
_training_status = {"running": False, "progress": [], "report": None}

config = Config()


def get_model():
    """Lazy-load the model (thread-safe)."""
    global _model
    with _model_lock:
        if _model is None:
            from app.models.neural_network import NeuralNetwork
            checkpoint = str(
                Path(config.get("paths.checkpoints", "public/checkpoints")) / "NeuralNetwork"
            )
            _model = NeuralNetwork(config)
            try:
                _model.load(checkpoint)
                logger.info("Model loaded from checkpoint.")
            except Exception:
                logger.warning("No checkpoint found, model not initialized.")
                _model = None
    return _model


