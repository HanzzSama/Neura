# =============================================================================
# Neura Configuration & AI Voice LiveKit Credentials
# =============================================================================

NEURA_ENV=development

# LiveKit WebRTC Cloud Credentials
# Dapatkan gratis di: https://cloud.livekit.io/
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# AI Models & Speech Processing
# OpenAI: digunakan untuk Brain (gpt-4o-mini) & TTS Audio
OPENAI_API_KEY=your_openai_api_key

# Deepgram: digunakan untuk STT (Speech-to-Text) real-time
DEEPGRAM_API_KEY=your_deepgram_api_key

# Cartesia (Opsional untuk Voice TTS ultra-cepat)
CARTESIA_API_KEY=

# =============================================================================
# Firebase Web Authentication & Firestore Database
# =============================================================================
# Dapatkan gratis di: https://console.firebase.google.com/
FIREBASE_API_KEY=AIzaSyD8XfBnr37fKwudLuJRWRAi2wMjU9KG838
FIREBASE_AUTH_DOMAIN=neura-f20b9.firebaseapp.com
FIREBASE_PROJECT_ID=neura-f20b9
FIREBASE_STORAGE_BUCKET=neura-f20b9.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=372520569422
FIREBASE_APP_ID=1:372520569422:web:f200b0ccee225284f5911f

# =============================================================================
# Firebase Admin SDK — Service Account (untuk generate email link server-side)
# =============================================================================
# Cara mendapatkan: Firebase Console → Project Settings → Service Accounts
#                   → Generate new private key → download JSON
#
# OPSI A (Direkomendasikan): Simpan file JSON & isi path-nya
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
#
# OPSI B: Isi langsung dari isi JSON (salin dari file JSON yang didownload)
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_private_key_here\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@neura-f20b9.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id

# =============================================================================
# SMTP Email — Pengirim Custom "Neura AI" via Gmail
# =============================================================================
# Cara mendapatkan Gmail App Password:
#   1. Buka myaccount.google.com → Security → 2-Step Verification (aktifkan)
