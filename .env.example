# =============================================================================
# NEURA AI — ENVIRONMENT TEMPLATE (.env.example)
# Salin file ini menjadi .env lalu sesuaikan nilai variabel di bawah:
#   Windows : copy .env.example .env
#   Linux/Mac: cp .env.example .env
# =============================================================================

# --- 1. APLIKASI & LINGKUNGAN ---
APP_NAME="Neura AI"
APP_ENV=development
APP_DEBUG=true
NEURA_ENV=development
FLASK_SECRET_KEY=your_generated_secret_key_here

# --- 2. BASIS DATA RELASIONAL MYSQL (LARAGON / MARIADB) ---
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=neura_db
DB_USERNAME=root
DB_PASSWORD=

# --- 3. LIVEKIT WEBRTC CLOUD (VOICE AI ASSISTANT) ---
# Dapatkan gratis di: https://cloud.livekit.io/
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# --- 4. SPEECH PROCESSING & REASONING ---
# OpenAI: digunakan untuk Brain Clinical Reasoner (gpt-4o-mini) & TTS Audio
OPENAI_API_KEY=your_openai_api_key

# Deepgram: digunakan untuk STT (Speech-to-Text) real-time streaming
DEEPGRAM_API_KEY=your_deepgram_api_key

# Cartesia: opsional untuk Voice TTS ultra-cepat
CARTESIA_API_KEY=

# --- 5. FIREBASE WEB AUTHENTICATION & CLIENT SDK ---
# Dapatkan di: https://console.firebase.google.com/
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
FIREBASE_APP_ID=your_firebase_app_id

# --- 6. FIREBASE ADMIN SDK (OPSIONAL / FALLBACK) ---
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
FIREBASE_PRIVATE_KEY_ID=your_private_key_id
FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nyour_private_key_here\n-----END RSA PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_CLIENT_ID=your_client_id

# --- 7. SMTP EMAIL (GMAIL APP PASSWORD - 2FA OTP & VERIFIKASI) ---
# Panduan pembuatan App Password Gmail:
#   1. Buka myaccount.google.com → Keamanan → Verifikasi 2 Langkah (Aktifkan)
#   2. Buka myaccount.google.com → Keamanan → Sandi Aplikasi (App passwords)
#   3. Buat sandi baru untuk aplikasi "Mail", salin 16-karakter sandi
SMTP_EMAIL=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SENDER_NAME=Neura AI
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
